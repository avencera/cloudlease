{
  "name": "cloudlease",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build:worker": "worker-build tests/worker --release",
    "test:worker": "pnpm run build:worker && vitest run --config vitest.worker.config.ts",
    "build:machines": "worker-build apps/machines --release",
    "test:machines": "pnpm run build:machines && vitest run --config vitest.machines.config.ts",
    "typecheck": "tsc --project tests/worker/tsconfig.json --noEmit && tsc --project apps/machines/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.28.1"
  }
}
