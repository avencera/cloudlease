{
  // the machines Worker; deploy it with ~/code/private-workbench/ops/cloudlease/machines-deploy.md
  "name": "cloudlease-machines",
  "main": "build/index.js",
  "compatibility_date": "2026-08-06",
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "Run" },
      { "name": "GATE", "class_name": "Gate" },
      { "name": "MONITOR", "class_name": "Monitor" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Run", "Gate", "Monitor"] }],
  // the tag sweep's cadence
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true },
  // secrets, set with `wrangler secret put`: DIGITALOCEAN_TOKEN, CLIENT_TOKENS, NTFY_URL,
  // optionally NTFY_TOKEN, PNAP_CLIENT_ID with PNAP_CLIENT_SECRET for phoenixNAP classes,
  // LATITUDE_API_KEY with LATITUDE_PROJECT (the project's proj_ ID) for Latitude.sh classes, and
  // AWS_ACCESS_KEY_ID with AWS_SECRET_ACCESS_KEY (the cloudlease-machines IAM user from
  // infra/aws-machines) for AWS classes, which also need the var AWS_REGIONS
  "vars": {
    // every resource this Worker creates or sweeps carries tags with this prefix; no other
    // cloudlease app may use it
    "CLOUDLEASE_TAG_PREFIX": "clm",
    // the most the machines not yet confirmed gone may cost per hour, in US cents: 96 fits
    // two aws-c8a-4xl or two s2.c2.large with their IP blocks, but not lat-m4-medium
    "HOURLY_SPEND_CAP_CENTS": "96",
    // the regions the AWS classes launch in and the sweep lists; infra/aws-machines covers
    // only us-east-1
    "AWS_REGIONS": "us-east-1",
    "MACHINES_CONFIG": {
      // where machines renew: the deployed Worker on the Avencera account
      "api_base": "https://cloudlease-machines.avencera.workers.dev",
      // limits of the 2026-11-25 live checks: two machines per run, two hours, and $1, two
      // hours of pnap-s2-small or an hour of two aws-c8a-4xl; raise them for a real pool
      "max_run_hours": 2,
      "max_machines_per_run": 2,
      "run_spend_cap_usd": "1.00",
      // a machine renews every 30 seconds; a run keeps the windows it was created with
      "heartbeat_ttl_secs": 180,
      // the boot grace of DigitalOcean classes; a phoenixNAP class waits 20 minutes, a
      // Latitude.sh class 15, and any class may set its own boot_grace_secs
      "boot_grace_secs": 480,
      // prices are list prices per hour; check DigitalOcean's with `doctl compute size list`
      // and phoenixNAP's with its product availability API before deploying. DigitalOcean's
      // are from 2026-11-24. A homebased machine needs 10 GiB free disk by default to take CI
      // jobs, so the 10 GB s-1vcpu-512mb-10gb size would never run one
      "classes": {
        "do-s1-1g": {
          "region": "nyc3",
          "size": "s-1vcpu-1gb",
          "image": "ubuntu-24-04-x64",
          "price_per_hour_usd": "0.00893",
          "max_hours": 1
        },
        // an E-2388G with 128 GB, billed every started hour; the locations are tried in
        // order when one is out of stock. Stock changes daily: on 2026-11-24 s3.c3.medium
        // ($0.47) had none anywhere, and s2.c2.large moved from SEA to NLD within hours
        "pnap-s2-large": {
          "provider": "phoenixnap",
          "server_type": "s2.c2.large",
          "locations": ["SEA", "NLD"],
          "os": "ubuntu/jammy",
          // the account key cloudlease-pnap; its private half is ~/.ssh/cloudlease-pnap on code
          "ssh_key_ids": ["6b060c5309b1f2cb75cb85f3"],
          // $0.40 for the server and $0.007 for its /31 IP block, both billed per started hour
          "price_per_hour_usd": "0.407",
          "max_hours": 1
        },
        // the same E-2388G with 64 GB and one NVMe disk, the fallback when s2.c2.large has no stock
        "pnap-s2-small": {
          "provider": "phoenixnap",
          "server_type": "s2.c2.small",
          "locations": ["SEA", "NLD"],
          "os": "ubuntu/jammy",
          // the account key cloudlease-pnap; its private half is ~/.ssh/cloudlease-pnap on code
          "ssh_key_ids": ["6b060c5309b1f2cb75cb85f3"],
          // $0.31 for the server and $0.007 for its /31 IP block
          "price_per_hour_usd": "0.317",
          "max_hours": 1
        },
        // a Latitude.sh class needs LATITUDE_API_KEY and LATITUDE_PROJECT; check the plan's
        // hourly price and per-site stock with GET /plans?filter[slug]=m4-metal-medium first.
        // On 2026-11-24 m4.metal.medium (EPYC 9124, 16 cores, 128 GB) cost $1.25 an hour
        // with one in stock at each of DAL, CHI, MIA2 and SJC2. One hour of it needs
        // HOURLY_SPEND_CAP_CENTS of at least 125 and a run spend cap of at least $1.25
        "lat-m4-medium": {
          "provider": "latitude",
          "plan": "m4-metal-medium",
          "sites": ["DAL", "CHI", "SJC2"],
          "operating_system": "ubuntu_24_04_x64_lts",
          "price_per_hour_usd": "1.25",
          "max_hours": 1
        },
        // an AWS class needs AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and its region in
        // AWS_REGIONS; the network, launch template and AMI come from infra/aws-machines
        // (`terraform output -json class_fields`). One instant fleet offers every type in
        // every zone, and EC2 picks the pool least likely to be interrupted. Spot in us-east-1
        // on 2026-11-24:
        // c8a.4xlarge $0.29 in 1f, $0.37 in 1b, $0.40 in 1d; c7a.4xlarge $0.27 to $0.40
        "aws-c8a-4xl": {
          "provider": "aws",
          "region": "us-east-1",
          "instance_types": ["c8a.4xlarge", "c7a.4xlarge"],
          "zones": [
            { "zone": "us-east-1f", "subnet_id": "subnet-014c36450d3136b24" },
            { "zone": "us-east-1b", "subnet_id": "subnet-02b6fa6fd5f8cd1f8" },
            { "zone": "us-east-1d", "subnet_id": "subnet-0b26c15634470738c" }
          ],
          // Canonical's Ubuntu 24.04 amd64 gp3 image, pinned in infra/aws-machines
          "image_id": "ami-0a951420c495183dc",
          "root_device_name": "/dev/sda1",
          "root_volume_gib": 50,
          "launch_template_id": "lt-010f6147c2e816163",
          "launch_template_version": 1,
          // above the Spot prices; EC2 never charges more than this for the instance
          "spot_max_price_usd": "0.45",
          // the max price plus about $0.01 for the 50 GiB gp3 root volume and the public IPv4
          // address, rounded up
          "price_per_hour_usd": "0.48",
          "max_hours": 1
        }
      },
      "apps": { "homebased": { "classes": ["do-s1-1g", "pnap-s2-large", "pnap-s2-small", "lat-m4-medium", "aws-c8a-4xl"] } }
    }
  }
}
